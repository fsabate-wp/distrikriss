generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  COD
}

model User {
  id           String            @id @default(cuid())
  name         String
  phone        String            @unique
  email        String?           @unique
  passwordHash String
  role         Role              @default(CLIENT)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  addresses    Address[]
  orders       Order[]
  pushSubs     PushSubscription[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  street    String
  number    String?
  reference String?
  city      String
  lat       Float
  lng       Float
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           String   @id @default(cuid())
  sku          String?  @unique
  name         String
  slug         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  unit         String
  presentation String?
  minQuantity  Decimal  @default(1) @db.Decimal(10, 2)
  stepQuantity Decimal  @default(1) @db.Decimal(10, 2)
  stock        Int      @default(-1)
  imageUrl     String?
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  discount     Int      @default(0)
  ivaRate      Int?
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]
}

model Order {
  id              String        @id @default(cuid())
  code            String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   String        @default("PENDING")
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)
  deliveryDate    DateTime
  slotId          String
  slotLabel       String
  addressId       String?
  address         Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressSnapshot Json
  notes           String?
  billingType     String        @default("CONSUMO_FINAL")
  billingData     Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  invoice         Invoice?
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  sku          String?
  unit         String
  presentation String?
  price        Decimal @db.Decimal(10, 2)
  quantity     Decimal @db.Decimal(10, 2)
  ivaRate      Decimal? @db.Decimal(4, 2)
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model Settings {
  id                      Int      @id @default(1)
  storeName               String   @default("DistriKriss")
  accentColor             String   @default("#1B5E20")
  secondaryColor          String   @default("#1B5E20")
  storeOpen               Boolean  @default(true)
  faviconUrl              String   @default("")
  appIconUrl              String   @default("")
  currency                String   @default("USD")
  phone                   String   @default("")
  whatsapp                String   @default("")
  email                   String   @default("")
  storeAddress            String   @default("")
  storeLat                Float
  storeLng                Float
  deliveryRadiusKm        Float    @default(5)
  deliveryFeeBase         Decimal  @default(0) @db.Decimal(10, 2)
  deliveryFeePerKm        Decimal  @default(0) @db.Decimal(10, 2)
  minOrderAmount          Decimal  @default(0) @db.Decimal(10, 2)
  orderCutoff             String   @default("18:00")
  deliveryDays            Json
  openHours               Json
  slots                   Json
  bankTransfer            Json
  ruc                     String   @default("")
  businessName            String   @default("")
  tradeName               String   @default("")
  sriEnabled              Boolean  @default(false)
  sriEnvironment          Int      @default(2)
  sriEstablishment        String   @default("003")
  sriEmissionPoint        String   @default("001")
  sriCertificateFile      String   @default("")
  sriCertificatePassword  String   @default("")
  sriObligadoContabilidad Boolean  @default(true)
  sriSpecialContributor   String   @default("")
  sriAddress              String   @default("")
  sriAccountingResolution String   @default("")
  sriIvaRate              Decimal  @default(15) @db.Decimal(4, 2)
  updatedAt               DateTime @updatedAt
}

model DeliveryZone {
  id               String   @id @default(cuid())
  name             String
  color            String   @default("#4CAF50")
  polygon          Json
  enabled          Boolean  @default(true)
  deliveryDays     Json
  slots            Json
  deliveryFeeBase  Decimal  @default(0) @db.Decimal(10, 2)
  deliveryFeePerKm Decimal  @default(0) @db.Decimal(10, 2)
  minOrderAmount   Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Invoice {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  establishment       String
  emissionPoint       String
  sequential          Int
  number              String    @unique
  accessKey           String
  status              String    @default("PENDING")
  xml                 String?   @db.Text
  authorizationNumber String?
  authorizationDate   DateTime?
  responseCode        String?
  responseMessage     String?
  retryCount          Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
