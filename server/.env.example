# --- API ---
PORT=4000
NODE_ENV=development

# --- Base de datos ---
DATABASE_URL="postgresql://distrikriss:distrikriss@localhost:5432/distrikriss?schema=public"

# --- Auth ---
# OBLIGATORIO en producción: el arranque falla si se dejan los valores de ejemplo.
# Genera cada uno con: openssl rand -hex 32
JWT_SECRET="cambiar-en-produccion"
JWT_REFRESH_SECRET="cambiar-en-produccion-refresh"
ACCESS_TOKEN_TTL="7d"
REFRESH_TOKEN_TTL="30d"
# En producción con HTTPS debe ser true (la app y la API están en dominios distintos)
COOKIE_SECURE=true

# --- Facturación electrónica (SRI) ---
# Clave con la que se cifra en reposo la contraseña del certificado .p12
# (AES-256-GCM). Si se cambia, la contraseña guardada deja de poder leerse y
# hay que volver a introducirla en el panel.
# OBLIGATORIA en producción. Generar con: openssl rand -hex 32
SRI_CERT_SECRET=""

# Cada cuánto el worker pregunta al SRI por las facturas sin resolver (ms).
SRI_JOB_INTERVAL_MS=30000
# Intervalo entre consultas de autorización de una misma factura (ms).
SRI_AUTH_POLL_MS=4000
# Cuántas veces se consulta antes de devolver el comprobante a la cola (ms).
SRI_AUTH_POLL_ATTEMPTS=8
# Espera base del reintento con retroceso exponencial, y su tope (ms).
SRI_RETRY_BASE_MS=60000
SRI_RETRY_MAX_MS=21600000
# Intentos máximos antes de dejar un comprobante de forma permanente en error.
SRI_MAX_ATTEMPTS=12
# Tiempo máximo de espera a los servicios web del SRI (ms).
SRI_SOAP_TIMEOUT_MS=20000

# --- URLs públicas ---
PUBLIC_API_URL="http://localhost:4000"
APP_URL="http://localhost:5173"
LANDING_URL="http://localhost:5174"

# --- Admin inicial (seed) ---
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@distrikriss.com"
ADMIN_PASSWORD="distrikriss-admin"
ADMIN_PHONE="0959841957"

# --- Push notifications (VAPID) ---
# Genera el par con: npm run vapid --workspace @distrikriss/server
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@distrikriss.com"

# --- WhatsApp (OpenWA) ---
# Envía mensajes vía OpenWA (https://www.open-wa.org). El número de la tienda
# para el aviso de "nuevo pedido" se lee de settings.whatsapp (Configuración en el admin).
# La sesión de OpenWA se vincula escaneando el QR en el dashboard; el session id es opaco (no es el número).
WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL="https://wa.distrikriss.com/api"
WHATSAPP_API_KEY=""
WHATSAPP_SESSION_ID=""
WHATSAPP_COUNTRY_CODE="593"
